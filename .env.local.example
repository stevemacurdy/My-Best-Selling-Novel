# .env.local.example
#
# Copy this file to .env.local for local development.
# In production (Vercel), set these in Project Settings > Environment Variables.
# Never commit .env.local — it is in .gitignore (created in TASK-001).
#
# Total: 22 environment variables (v1 final count per REMEDIATION_OVERVIEW.md v4 changelog).
#
# Each variable has two annotations:
#   - A "Where to retrieve" comment immediately above it (per Q-1.3 default).
#   - An inline "# Phase N — TASK-ID" comment marking when the var is first needed.
#     Use the inline comments as a provisioning checklist.

# ─── Phase 1: Site ─────────────────────────────────────────────────────────
# Where to retrieve: your deployed site URL (Vercel domain or custom domain)
NEXT_PUBLIC_SITE_URL=                              # Phase 1 — TASK-001 (literal value)

# ─── Phase 1: Supabase ─────────────────────────────────────────────────────
# Where to retrieve: Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=                          # Phase 1 — TASK-004

# Where to retrieve: Supabase Dashboard > Project Settings > API > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=                     # Phase 1 — TASK-004

# Where to retrieve: Supabase Dashboard > Project Settings > API > service_role secret
# WARNING: server-side only; NEVER expose to client. Used by Stripe webhook handler only.
SUPABASE_SERVICE_ROLE_KEY=                         # Phase 1 — TASK-004

# ─── Phase 1: Sentry (R-TASK-106 runs alongside TASK-001) ──────────────────
# Where to retrieve: sentry.io > Settings > Projects > [your project] > Client Keys (DSN)
# Same DSN value goes in both vars; the NEXT_PUBLIC_ variant is exposed to the client SDK.
SENTRY_DSN=                                        # Phase 1 — R-TASK-106
NEXT_PUBLIC_SENTRY_DSN=                            # Phase 1 — R-TASK-106

# ─── Phase 4: Stripe (4 price IDs — lifetime variants removed 2026-05-06 per Decision #29) ─
# Where to retrieve: Stripe Dashboard > Developers > API keys
STRIPE_SECRET_KEY=                                 # Phase 4 — TASK-020
STRIPE_PUBLISHABLE_KEY=                            # Phase 4 — TASK-020

# Where to retrieve: Stripe Dashboard > Developers > Webhooks > [your endpoint] > Signing secret
STRIPE_WEBHOOK_SECRET=                             # Phase 4 — TASK-024

# Where to retrieve: Stripe Dashboard > Products > [Author Plan] > Pricing
STRIPE_PRICE_AUTHOR_MONTHLY=                       # Phase 4 — TASK-020
STRIPE_PRICE_AUTHOR_ANNUAL=                        # Phase 4 — TASK-020

# Where to retrieve: Stripe Dashboard > Products > [Publisher Plan] > Pricing
STRIPE_PRICE_PUBLISHER_MONTHLY=                    # Phase 4 — TASK-020
STRIPE_PRICE_PUBLISHER_ANNUAL=                     # Phase 4 — TASK-020

# ─── Phase 4: Anthropic ────────────────────────────────────────────────────
# Where to retrieve: console.anthropic.com > Settings > API Keys
ANTHROPIC_API_KEY=                                 # Phase 4 — TASK-021

# ─── Phase 8: Resend ───────────────────────────────────────────────────────
# Where to retrieve: resend.com > API Keys
RESEND_API_KEY=                                    # Phase 8 — TASK-054

# Where to retrieve: literal value; matches Decision #28 brand domain
RESEND_FROM_EMAIL=noreply@mybestsellingnovel.com   # Phase 8 — TASK-054

# ─── Phase 8: Newsletter (R-TASK-170 — Sunday Prompt) ──────────────────────
# Where to retrieve: Resend Dashboard > Audiences > "MyBSN Sunday Prompt" > Audience ID
RESEND_AUDIENCE_ID=                                # Phase 8 — R-TASK-170

# Where to retrieve: generate locally — `openssl rand -hex 32` (HMAC server secret, 24h TTL tokens)
NEWSLETTER_TOKEN_SECRET=                           # Phase 8 — R-TASK-170

# ─── Phase 9: Google Analytics + Server-Side Measurement Protocol ──────────
# Where to retrieve: GA4 Admin > Data Streams > Web Stream Details > Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=                     # Phase 9 — TASK-058

# Where to retrieve: generate locally — `openssl rand -hex 32` (gates internal GA proxy route)
INTERNAL_SECRET=                                   # Phase 9 — TASK-058

# Where to retrieve: GA4 Admin > Data Streams > [your stream] > Measurement Protocol API secrets
GA_API_SECRET=                                     # Phase 9 — TASK-058

# ─── Phase 11: Affiliate Waitlist (R-TASK-172) ─────────────────────────────
# Where to retrieve: Resend Dashboard > Audiences > "MyBSN Affiliate Waitlist" > Audience ID
RESEND_AFFILIATE_AUDIENCE_ID=                      # Phase 11 — R-TASK-172

# ─── Intentionally NOT here ────────────────────────────────────────────────
# Removed 2026-05-06 (A.3 cascade — lifetime tier eliminated):
#   STRIPE_PRICE_AUTHOR_LIFETIME, STRIPE_PRICE_PUBLISHER_LIFETIME, NEXT_PUBLIC_LIFETIME_ENABLED
# Removed 2026-05-06 (replaced by profiles.role per Decision #31 + R-TASK-113):
#   ADMIN_EMAILS
